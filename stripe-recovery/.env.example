# Copy to .env and fill in your own Stripe test-mode secret key to run the demo (or
# the detector) against a real account instead of the zero-setup fake one. Never a
# live key: STRIPE_RECOVERY_SECRET_KEY must start with sk_test_ or rk_test_ (ADR-0003,
# ADR-0013). Leave this unset and everything runs offline, no Stripe account needed.
STRIPE_RECOVERY_SECRET_KEY=sk_test_...
