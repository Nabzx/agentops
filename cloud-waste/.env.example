# Copy to .env and set CLOUD_WASTE_AWS_REGION to run the demo (or the detector)
# against a real AWS account instead of the zero-setup fake one. No secret key goes
# here - AWS credentials resolve through boto3's own default chain (env vars, a named
# profile, an IAM role, SSO), never a project-specific setting (ADR-0024). Leave this
# unset and everything runs offline, no AWS account needed.
CLOUD_WASTE_AWS_REGION=us-east-1
# Optional - a named profile from ~/.aws/credentials, if you don't want the default.
# CLOUD_WASTE_AWS_PROFILE_NAME=my-profile

# Optional - see the Critic section of the README. Never set for you.
# EPHOR_CRITIC_API_KEY=sk-ant-...
